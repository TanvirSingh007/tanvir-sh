---
/**
 * Shell-style navigation.
 *
 * Progressive enhancement, strictly: every destination is a real link that
 * already works elsewhere on the page. Without JS the trigger stays hidden and
 * nothing is lost. Crawlers never see this.
 *
 * Native <dialog> does the focus trap, Esc handling and background inerting.
 */
import { getCollection } from 'astro:content';
import { profile } from '../data/profile';

// The pages print commands as section headers. Those exact strings have to
// resolve here, or the site is advertising commands that do not work.
const workEntries = (await getCollection('work'))
  .sort((a, b) => a.data.order - b.data.order)
  .map((e) => ({ slug: e.id, title: e.data.title }));
---

<button type="button" id="cmd-open" hidden aria-haspopup="dialog">
  <span class="mono" aria-hidden="true">▸</span>
  <span class="cmd-open__text mono">run a command</span>
</button>

<dialog id="cmd" aria-label="Command bar">
  <div class="cmd__out" id="cmd-out" role="log" aria-live="polite"></div>
  <form id="cmd-form" method="dialog">
    <label for="cmd-in" class="cmd__prompt mono" aria-label="Command input">
      <span aria-hidden="true">tanvir@sh ~ %</span>
    </label>
    <input
      id="cmd-in"
      name="cmd"
      type="text"
      autocomplete="off"
      autocapitalize="off"
      autocorrect="off"
      spellcheck="false"
      enterkeyhint="go"
      placeholder="try: ls"
    />
  </form>
</dialog>

<style>
  #cmd-open {
    position: fixed;
    right: max(1rem, env(safe-area-inset-right, 0px));
    bottom: calc(1rem + env(safe-area-inset-bottom, 0px));
    z-index: 40;
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    min-height: 44px;
    padding: 0 0.9rem;
    background: var(--bg-raised);
    color: var(--accent);
    border: 1px solid var(--border);
    font-family: var(--mono);
    font-size: var(--step--1);
    cursor: pointer;
    box-shadow: 0 6px 24px rgb(0 0 0 / 0.35);
  }
  #cmd-open:hover { border-color: var(--accent-dim); }
  .cmd-open__text { color: var(--text-dim); }
  @media (max-width: 34rem) {
    .cmd-open__text { display: none; }
    #cmd-open { padding: 0; min-width: 48px; justify-content: center; }
  }

  #cmd {
    border: 1px solid var(--border);
    background: var(--bg-raised);
    color: var(--text);
    padding: 0;
    width: min(46rem, 100%);
    max-width: 100%;
    margin-inline: auto;
  }
  #cmd::backdrop { background: rgb(0 0 0 / 0.6); backdrop-filter: blur(2px); }

  /* Bottom sheet on phones, centred panel on larger screens. */
  @media (max-width: 40rem) {
    #cmd {
      margin: auto auto 0;
      width: 100%;
      border-bottom: 0;
      padding-bottom: env(safe-area-inset-bottom, 0px);
    }
  }
  @media (min-width: 40.0625rem) {
    #cmd { margin-top: 12vh; }
  }

  .cmd__out {
    font-family: var(--mono);
    font-size: var(--step--1);
    line-height: 1.7;
    max-height: min(46vh, 22rem);
    overflow-y: auto;
    padding: 0.9rem 1rem 0;
  }
  .cmd__out:empty { display: none; }

  /* This markup is inserted at runtime, so it never gets Astro's scoping
     attribute — these have to be :global() or they silently do nothing. */
  .cmd__out :global(.echo) { color: var(--text-faint); }
  .cmd__out :global(.err) { color: var(--accent); }
  .cmd__out :global(ul) { list-style: none; margin: 0 0 0.6rem; padding: 0; }
  .cmd__out :global(li) { display: flex; gap: 1rem; align-items: baseline; }
  .cmd__out :global(b) {
    color: var(--accent);
    font-weight: 600;
    flex: 0 0 auto;
    min-width: 7.5rem;
  }
  .cmd__out :global(span) { color: var(--text-dim); }

  #cmd-form {
    display: flex;
    align-items: center;
    gap: 0.6rem;
    padding: 0.85rem 1rem;
    border-top: 1px solid var(--border);
  }
  .cmd__prompt { color: var(--accent); font-size: var(--step--1); white-space: nowrap; }
  #cmd-in {
    flex: 1;
    min-width: 0;
    background: none;
    border: 0;
    color: var(--text);
    font-family: var(--mono);
    /* 16px minimum stops iOS Safari zooming the viewport on focus. */
    font-size: max(16px, var(--step-0));
    padding: 0.35rem 0;
  }
  #cmd-in:focus { outline: none; }
  #cmd-in::placeholder { color: var(--text-faint); }
</style>

<script is:inline define:vars={{ links: profile.links, email: profile.email, work: workEntries }}>
  (() => {
    const dialog = document.getElementById('cmd');
    const openBtn = document.getElementById('cmd-open');
    const form = document.getElementById('cmd-form');
    const input = document.getElementById('cmd-in');
    const out = document.getElementById('cmd-out');
    if (!dialog || !openBtn || !form || !input || !out) return;

    // Mirrors the navbar, so `ls` and the nav never disagree.
    const routes = [
      { name: 'home', path: '/', desc: 'whoami' },
      { name: 'agents', path: '/agents/', desc: 'engineering with agents' },
      { name: 'work', path: '/work/', desc: 'selected work' },
      { name: 'homelab', path: '/homelab/', desc: 'self-hosted infrastructure' },
      { name: 'experience', path: '/experience/', desc: 'roles and dates' },
      { name: 'trilogy', path: '/experience/trilogy/', desc: 'what I do there' },
      { name: 'auribises', path: '/experience/auribises/', desc: 'what I did there' },
      { name: 'about', path: '/about/', desc: 'background' },
      { name: 'contact', path: '/#contact', desc: 'get in touch' },
    ];
    const externals = { github: links.github, linkedin: links.linkedin, email: `mailto:${email}` };

    /**
     * Every name `cd` and `cat` accept.
     *
     * The pages print commands like `cat stack.txt` as section headers, so each
     * of those strings has to appear here. If you add a printed command to a
     * page, add its target here too.
     */
    const targets = {
      '~': '/',
      home: '/',
      whoami: '/',
      work: '/work/',
      about: '/about/',
      'about.md': '/about/',
      agents: '/agents/',
      'agents.md': '/agents/',
      homelab: '/homelab/',
      'homelab.md': '/homelab/',
      capabilities: '/#domains',
      'capabilities.md': '/#domains',
      experience: '/experience/',
      'experience.txt': '/experience/',
      trilogy: '/experience/trilogy/',
      'trilogy.md': '/experience/trilogy/',
      auribises: '/experience/auribises/',
      'auribises.md': '/experience/auribises/',
      stack: '/#stack',
      'stack.txt': '/#stack',
      contact: '/#contact',
      'contact.txt': '/#contact',
    };
    for (const w of work) {
      targets[w.slug] = `/work/${w.slug}/`;
      targets[`${w.slug}.md`] = `/work/${w.slug}/`;
    }

    openBtn.hidden = false;

    const open = () => {
      if (!dialog.open) dialog.showModal();
      input.focus();
    };
    openBtn.addEventListener('click', open);

    document.addEventListener('keydown', (e) => {
      const typing = /^(INPUT|TEXTAREA|SELECT)$/.test(document.activeElement?.tagName ?? '');
      if ((e.key === 'k' && (e.metaKey || e.ctrlKey)) || (e.key === '/' && !typing)) {
        e.preventDefault();
        open();
      }
    });

    const esc = (s) => String(s).replace(/[&<>"]/g, (c) =>
      ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;' })[c]);
    const print = (html) => {
      out.insertAdjacentHTML('beforeend', html);
      out.scrollTop = out.scrollHeight;
    };
    const echo = (cmd) => print(`<div class="echo">~ % ${esc(cmd)}</div>`);
    const go = (href) => {
      // A page route unloads the document and takes the dialog with it, but a
      // same-page hash only scrolls, leaving the palette open on top of the
      // section it just jumped to. Close it either way.
      dialog.close();
      window.location.href = href;
    };

    const list = (rows) =>
      `<ul>${rows.map((r) => `<li><b>${esc(r.name)}</b><span>${esc(r.desc)}</span></li>`).join('')}</ul>`;

    /** Subsequence match, so 'wk' finds 'work'. */
    const fuzzy = (q, s) => {
      let i = 0;
      for (const ch of s) if (ch === q[i]) i++;
      return i === q.length;
    };

    const run = (raw) => {
      const line = raw.trim();
      if (!line) return;
      echo(line);
      const [cmd, ...rest] = line.split(/\s+/);
      // Drop flags, so `ls -l` behaves the way anyone typing it expects.
      const arg = rest
        .filter((a) => !a.startsWith('-'))
        .join(' ')
        .toLowerCase()
        .replace(/^\/|\/$/g, '');

      switch (cmd.toLowerCase()) {
        case 'help':
          return print(list([
            { name: 'ls', desc: 'list pages' },
            { name: 'cd <page>', desc: 'go to a page' },
            { name: 'cat <page>', desc: 'same as cd' },
            { name: 'whoami', desc: 'go home' },
            { name: 'open <site>', desc: 'github, linkedin, email' },
            { name: 'theme', desc: 'toggle light/dark' },
            { name: 'clear', desc: 'clear this output' },
          ]));

        case 'ls': {
          if (arg === 'work') {
            return print(list(work.map((w) => ({ name: w.slug, desc: w.title }))));
          }
          return print(list(routes));
        }

        case 'clear':
          out.innerHTML = '';
          return;

        case 'whoami':
          return go('/');

        case 'theme':
          document.getElementById('theme-toggle')?.click();
          return print('<div><span>theme toggled</span></div>');

        case 'open': {
          const url = externals[arg];
          if (url) return go(url);
          return print(`<div class="err">open: no such target: ${esc(arg)}</div>`);
        }

        case 'cd':
        case 'cat': {
          if (!arg || arg === '~') return go('/');
          if (arg === '.') return; // no-op, same as a real shell
          const dest = targets[arg];
          if (dest) return go(dest);
          return print(`<div class="err">${esc(cmd)}: no such file or directory: ${esc(arg)}</div>`);
        }

        default: {
          // Not a command — treat it as search, so people who do not know
          // shell still get somewhere useful.
          const q = line.toLowerCase();
          const hits = routes.filter((r) => fuzzy(q, r.name) || r.desc.toLowerCase().includes(q));
          if (hits.length === 1) return go(hits[0].path);
          if (hits.length > 1) return print(list(hits));
          return print(`<div class="err">zsh: command not found: ${esc(cmd)} — try <b>help</b></div>`);
        }
      }
    };

    form.addEventListener('submit', (e) => {
      e.preventDefault();
      const value = input.value;
      input.value = '';
      run(value);
    });

    dialog.addEventListener('close', () => { input.value = ''; });
  })();
</script>
