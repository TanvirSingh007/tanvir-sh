---
import '../styles/global.css';
import { profile, site } from '../data/profile';
import CommandBar from '../components/CommandBar.astro';
import Icon from '../components/Icon.astro';

interface Props {
  title: string;
  description: string;
  /** Shown in the shell prompt, e.g. '~/work'. */
  cwd?: string;
  jsonLd?: Record<string, unknown>;
}

const { title, description, cwd = '~', jsonLd } = Astro.props;
const canonical = new URL(Astro.url.pathname, Astro.site).href;
const ogImage = new URL(
  `/og/${Astro.url.pathname.replace(/^\/|\/$/g, '') || 'index'}.png`,
  Astro.site
).href;

const nav = [
  { href: '/agents/', label: 'agents' },
  { href: '/work/', label: 'work' },
  { href: '/homelab/', label: 'homelab' },
  { href: '/experience/', label: 'experience' },
  { href: '/about/', label: 'about' },
];
const path = Astro.url.pathname;
const isCurrent = (href: string) => path.startsWith(href);
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />

    <meta property="og:type" content="profile" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:site_name" content={site.domain} />
    <meta name="twitter:card" content="summary_large_image" />

    <link rel="icon" href="/favicon.ico" sizes="48x48" />
    <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32x32.png" />
    <link rel="icon" type="image/png" sizes="16x16" href="/favicon-16x16.png" />
    <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png" />
    <link rel="manifest" href="/site.webmanifest" />

    <link rel="sitemap" href="/sitemap-index.xml" />
    <link rel="alternate" type="application/rss+xml" href="/sitemap-index.xml" />
    <meta name="theme-color" content="#0b0c0e" media="(prefers-color-scheme: dark)" />
    <meta name="theme-color" content="#faf8f3" media="(prefers-color-scheme: light)" />

    {jsonLd && <script is:inline type="application/ld+json" set:html={JSON.stringify(jsonLd)} />}

    {/* Blocking on purpose: a few bytes here beats a flash of the wrong theme. */}
    <script is:inline>
      (() => {
        try {
          const saved = localStorage.getItem('theme');
          if (saved === 'light' || saved === 'dark') {
            document.documentElement.dataset.theme = saved;
          }
        } catch {}
      })();
    </script>
  </head>

  <body>
    <a href="#main" class="skip">skip to content</a>

    <header class="wrap site-head">
      <a href="/" class="site-head__brand mono" aria-label="Home">
        {site.domain}
      </a>
      <nav aria-label="Primary">
        <ul>
          {nav.map((item) => (
            <li>
              <a href={item.href} aria-current={isCurrent(item.href) ? 'page' : undefined}>
                {item.label}
              </a>
            </li>
          ))}
        </ul>
      </nav>
      <button type="button" id="theme-toggle" aria-label="Toggle colour theme" title="Toggle theme">
        <span aria-hidden="true">◐</span>
      </button>
    </header>

    <main id="main" class="wrap">
      <p class="prompt" data-cwd={cwd}><slot name="command" /></p>
      <slot />
    </main>

    <footer class="wrap site-foot">
      <ul class="icon-links icon-links--row">
        <li><a href={`mailto:${profile.email}`}><Icon name="email" />email</a></li>
        <li><a href={profile.links.github} rel="me noopener"><Icon name="github" />github</a></li>
        <li><a href={profile.links.linkedin} rel="me noopener"><Icon name="linkedin" />linkedin</a></li>
      </ul>
      <p class="hint">
        this site also answers to <code>curl {site.domain}</code>
      </p>
    </footer>

    <CommandBar />

    <style>
      .skip {
        position: absolute;
        left: -9999px;
        top: 0;
        background: var(--accent);
        color: var(--bg);
        padding: 0.6rem 1rem;
        font-family: var(--mono);
        z-index: 100;
      }
      .skip:focus { left: 0; }

      .site-head {
        /* Sticky so the nav survives an in-page jump to #agents or #experience.
           Without it those links scroll the bar off screen, while /work/ and
           /about/ load at the top with it visible: same nav, two behaviours. */
        position: sticky;
        top: 0;
        z-index: 30;
        background: var(--bg);
        display: flex;
        align-items: center;
        flex-wrap: wrap;
        gap: clamp(0.75rem, 4vw, 2rem);
        padding-block: 1.1rem;
        font-family: var(--mono);
        font-size: var(--step--1);
        padding-top: calc(1.1rem + env(safe-area-inset-top, 0px));
      }
      /* Inset to match the content, same reason as the footer rule. */
      .site-head::after {
        content: '';
        position: absolute;
        bottom: 0;
        left: var(--gutter);
        right: var(--gutter);
        border-bottom: 1px solid var(--border);
      }
      .site-head__brand {
        font-weight: 600;
        text-decoration: none;
        color: var(--accent);
        letter-spacing: -0.02em;
      }
      .site-head nav { margin-left: auto; }
      .site-head ul {
        display: flex;
        flex-wrap: wrap;
        gap: 0 clamp(0.7rem, 2.6vw, 1.4rem);
        list-style: none;
        margin: 0;
        padding: 0;
      }
      .site-head a {
        text-decoration: none;
        color: var(--text-dim);
        display: inline-flex;
        align-items: center;
        min-height: 44px;
      }
      .site-head a:hover,
      .site-head a[aria-current='page'] { color: var(--text); }
      .site-head a[aria-current='page'] { text-decoration: underline; text-decoration-color: var(--accent); }

      #theme-toggle {
        background: none;
        border: 1px solid var(--border);
        color: var(--text-dim);
        font-size: 0.9rem;
        cursor: pointer;
        min-width: 44px;
        min-height: 44px;
        display: grid;
        place-items: center;
      }
      #theme-toggle:hover { color: var(--accent); border-color: var(--accent-dim); }

      /* Four links plus the brand will not fit a phone on one row. Drop the nav
         to its own line rather than shrinking the tap targets. */
      @media (max-width: 32rem) {
        .site-head { row-gap: 0.25rem; padding-bottom: 0.5rem; }
        .site-head nav { order: 3; flex: 1 0 100%; margin-left: 0; }
        .site-head ul { gap: 1rem; }
        #theme-toggle { margin-left: auto; }
      }

      .site-foot {
        position: relative;
        padding-block: 2rem 6rem;
        font-family: var(--mono);
        font-size: var(--step--1);
        text-align: center;
      }
      .site-foot :global(.icon-links--row) { justify-content: center; }
      /* The rule lives on a pseudo-element inset by the gutter. On .site-foot
         itself, border-top spans the padding box and overhangs the text by a
         gutter on each side, which reads as a misalignment. */
      .site-foot::before {
        content: '';
        position: absolute;
        top: 0;
        left: var(--gutter);
        right: var(--gutter);
        border-top: 1px solid var(--border);
      }
      .site-foot .hint { margin: 0 auto; }
    </style>

    <script is:inline>
      document.getElementById('theme-toggle')?.addEventListener('click', () => {
        const root = document.documentElement;
        const current =
          root.dataset.theme ??
          (matchMedia('(prefers-color-scheme: light)').matches ? 'light' : 'dark');
        const next = current === 'dark' ? 'light' : 'dark';
        root.dataset.theme = next;
        try { localStorage.setItem('theme', next); } catch {}
      });
    </script>
  </body>
</html>
