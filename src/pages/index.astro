---
import { getCollection } from 'astro:content';
import Base from '../layouts/Base.astro';
import { profile, site } from '../data/profile';
import Experience from '../components/Experience.astro';
import { domains } from '../data/domains';
import { emphasize, plain } from '../lib/emphasis';
import { profilePageSchema } from '../lib/jsonld';

const featured = (await getCollection('work'))
  .filter((e) => e.data.featured)
  .sort((a, b) => a.data.order - b.data.order)
  .slice(0, 3);

// Meta descriptions and OG tags take plain text, never markup.
const plainSummary = plain(profile.summary);
---

<Base title={site.title} description={plainSummary} cwd="~" jsonLd={profilePageSchema()}>
  <span slot="command">whoami</span>

  {/* A section like the rest, so `section + section` spaces every gap equally. */}
  <section class="intro">
    <h1>{profile.name}</h1>
    <p class="lede">
      {profile.role} at {profile.employer}. <strong>{profile.tagline}</strong>
    </p>
    <p class="summary" set:html={emphasize(profile.summary)} />

    <p class="stats__src mono">
      two years at <a href="/experience/trilogy/">Trilogy</a>, across six enterprise products
    </p>
    <dl class="stats">
      {profile.stats.map((s) => (
        <div>
          <dt>{s.value}</dt>
          <dd>{s.label}</dd>
        </div>
      ))}
    </dl>
  </section>

  <section id="domains" aria-labelledby="domains-h">
    <p class="prompt" data-cwd="~"><span>cat capabilities.md</span></p>
    <h2 id="domains-h">What I do</h2>
    <p class="summary">
      Four areas, and I have shipped in all of them. Every line below links to the
      work it came from.
    </p>

    <ol class="caps">
      {domains.map((d, i) => (
        <li class="caps__item">
          <div class="caps__head">
            <span class="caps__n">{String(i + 1).padStart(2, '0')}</span>
            <h3>{d.label}</h3>
          </div>
          <p class="caps__blurb">{d.blurb}</p>
          <ul class="caps__proof">
            {d.proof.map((pf) => (
              <li>
                <a href={pf.href} set:html={emphasize(pf.text)} />
              </li>
            ))}
          </ul>
        </li>
      ))}
    </ol>
  </section>

  <section id="work" aria-labelledby="work-h">
    <p class="prompt" data-cwd="~"><span>ls work/</span></p>
    <h2 id="work-h">Selected work</h2>
    {featured.length === 0 ? (
      <p class="summary">Case studies are being written up.</p>
    ) : (
      <ul class="rule-list">
        {featured.map((entry) => (
          <li>
            <a class="entry" href={`/work/${entry.id}/`}>
              <div class="entry__title">{entry.data.title}</div>
              <div class="entry__meta">{entry.data.role} · {entry.data.period}</div>
              <p class="entry__summary" set:html={emphasize(entry.data.summary)} />
            </a>
          </li>
        ))}
      </ul>
    )}
    <p class="more mono"><a href="/work/">all work →</a></p>
  </section>

  <section id="experience" aria-labelledby="experience-h">
    <p class="prompt" data-cwd="~"><span>cat experience.txt</span></p>
    <h2 id="experience-h">Where I have worked</h2>
    <Experience />
    <p class="more mono"><a href="/experience/">education and certifications →</a></p>
  </section>

  <section id="stack" aria-labelledby="stack-h">
    <p class="prompt" data-cwd="~"><span>cat stack.txt</span></p>
    <h2 id="stack-h">What I work with</h2>
    {profile.domains.map((d) => (
      <div class="domain">
        <span class="label">{d.label}</span>
        <ul class="tags">{d.items.map((i) => <li>{i}</li>)}</ul>
      </div>
    ))}
  </section>

  <section id="contact" aria-labelledby="contact-h">
    <p class="prompt" data-cwd="~"><span>cat contact.txt</span></p>
    <h2 id="contact-h">Get in touch</h2>
    <p class="summary">
      Email is best: <a href={`mailto:${profile.email}`}>{profile.email}</a>. I
      read everything and reply to anything specific.
    </p>
  </section>

  <style>
    .lede {
      font-family: var(--mono);
      font-size: var(--step-1);
      color: var(--text-dim);
      margin-top: 1.1rem;
      max-width: 38ch;
      text-wrap: balance;
    }
    .lede strong { color: var(--text); font-weight: 600; }
    .summary { color: var(--text-dim); }
    .stats__src {
      font-size: var(--step--1);
      color: var(--text-faint);
      margin: 2rem 0 -1.25rem;
    }
    .stats__src a { color: var(--text-dim); text-decoration-color: var(--border); }
    .stats__src a:hover { color: var(--accent); text-decoration-color: var(--accent); }
    .summary strong { color: var(--text); font-weight: 600; }
    .domain { margin-bottom: 1.1rem; }
    .domain:last-child { margin-bottom: 0; }
    .domain .label { display: block; margin-bottom: 0.4rem; }
    .more { margin-top: 1.25rem; font-size: var(--step--1); }
    .more a { text-decoration: none; color: var(--accent); }
    .more a:hover { text-decoration: underline; }

    .caps {
      list-style: none;
      margin: 1.75rem 0 0;
      padding: 0;
      display: grid;
      gap: 1px;
      background: var(--border);
      border: 1px solid var(--border);
    }
    .caps__item { background: var(--bg); padding: 1.4rem 1.25rem; }
    .caps__head { display: flex; align-items: baseline; gap: 0.75rem; }
    .caps__n {
      font-family: var(--mono);
      font-size: var(--step--1);
      color: var(--accent);
      flex: 0 0 auto;
    }
    .caps__head h3 {
      font-size: var(--step-1);
      margin: 0;
      letter-spacing: -0.015em;
    }
    .caps__blurb {
      color: var(--text-faint);
      font-size: var(--step--1);
      margin: 0.5rem 0 0.9rem;
      padding-left: 2.1rem;
      max-width: 60ch;
    }
    .caps__proof { list-style: none; margin: 0; padding: 0 0 0 2.1rem; }
    .caps__proof li { margin-bottom: 0.4rem; }
    .caps__proof li:last-child { margin-bottom: 0; }
    .caps__proof a {
      display: block;
      color: var(--text-dim);
      font-size: var(--step--1);
      line-height: 1.65;
      text-decoration: none;
      position: relative;
      padding-left: 1.1rem;
    }
    .caps__proof a::before {
      content: '▸';
      position: absolute;
      left: 0;
      color: var(--accent);
      font-family: var(--mono);
      font-size: 0.85em;
    }
    .caps__proof a :global(strong) { color: var(--text); font-weight: 600; }
    .caps__proof a:hover,
    .caps__proof a:focus-visible { color: var(--text); text-decoration: underline; }
    .caps__proof a:hover :global(strong) { color: var(--accent); }

    @media (max-width: 34rem) {
      .caps__blurb, .caps__proof { padding-left: 0; }
    }

  </style>
</Base>
